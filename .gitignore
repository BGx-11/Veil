# ═══════════════════════════════════════════════════
# Veil Browser .gitignore
# ═══════════════════════════════════════════════════

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build outputs
/.next/
/out/
/build/
/dist/
/release/
/android/
/ios/

# Archives
*.zip
*.7z
*.tar.gz
*.rar
!Veil_Setup_v1.zip

# Electron Builder
*.exe
*.dmg
*.AppImage
*.snap
*.deb
*.rpm
*.msi
*.blockmap
*.yml
!electron-builder.yml
!Veil_Setup_v1.exe

# Tor binaries (downloaded via postinstall)
/bin/tor/

# Testing
/coverage

# Environment
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Editor & IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Misc
*.pem
.vercel
scratch.js
test-*.js
