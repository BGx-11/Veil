# ═══════════════════════════════════════════════════
# Veil Browser .gitignore
# ═══════════════════════════════════════════════════

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build outputs
/.next/
/out/
/build/
/dist/
/release/
/android/
/ios/

# Tauri build artifacts
/src-tauri/target/

# Legacy Electron build artifacts
/release-forge/

# Archives & Installers
*.zip
*.7z
*.tar.gz
*.rar
*.exe
*.dmg
*.AppImage
*.snap
*.deb
*.rpm
*.msi
*.blockmap

# Tor binaries (downloaded via postinstall)
/bin/tor/

# Testing
/coverage

# Environment
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Editor & IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Misc
*.pem
.vercel
scratch.js
test-*.js
update-*.js

# Agent/AI Repo copies
.surfer_repo/
.zen_desktop_repo/

# Scratch & test outputs
*.txt
*.html
parse.js

